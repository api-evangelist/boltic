{
  "opencollection": "1.0.0",
  "info": {
    "name": "Boltic Gateway Certificates API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Certificates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Boltic List all certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.boltic.io/v1/certificates"
          },
          "docs": "Boltic List all certificates"
        },
        {
          "info": {
            "name": "Boltic Upload a new certificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.boltic.io/v1/certificates",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Boltic Upload a new certificate"
        }
      ]
    }
  ],
  "bundled": true
}