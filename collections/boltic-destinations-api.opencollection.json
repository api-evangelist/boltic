{
  "opencollection": "1.0.0",
  "info": {
    "name": "Boltic Gateway Certificates Destinations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Destinations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Boltic List available destination types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.boltic.io/v1/destinations"
          },
          "docs": "Boltic List available destination types"
        },
        {
          "info": {
            "name": "Boltic List stream destinations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.boltic.io/v1/streams/destinations"
          },
          "docs": "Boltic List stream destinations"
        },
        {
          "info": {
            "name": "Boltic Create a stream destination",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.boltic.io/v1/streams/destinations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configure a destination for delivering stream events."
        }
      ]
    }
  ],
  "bundled": true
}