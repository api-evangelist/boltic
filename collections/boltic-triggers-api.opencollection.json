{
  "opencollection": "1.0.0",
  "info": {
    "name": "Boltic Gateway Certificates Triggers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Triggers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Boltic List available triggers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.boltic.io/v1/triggers"
          },
          "docs": "Retrieve a list of all available trigger types."
        }
      ]
    }
  ],
  "bundled": true
}