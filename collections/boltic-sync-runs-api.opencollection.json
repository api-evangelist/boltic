{
  "opencollection": "1.0.0",
  "info": {
    "name": "Boltic Gateway Certificates Sync Runs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sync Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Boltic List sync runs for a pipe",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.boltic.io/v1/pipes/:pipeId/runs",
            "params": [
              {
                "name": "pipeId",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve the sync execution history for a pipe."
        }
      ]
    }
  ],
  "bundled": true
}